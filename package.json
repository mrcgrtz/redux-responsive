{
    "name": "@mrcgrtz/redux-responsive",
    "version": "5.0.0",
    "description": "Utilities for easily creating responsive designs in a redux architecture.",
    "keywords": [
        "redux",
        "react",
        "responsive",
        "media-queries",
        "breakpoints"
    ],
    "license": "MIT",
    "author": "Alec Aivazis",
    "contributors": [
        "Marc Görtz <mail@marcgoertz.de> (https://marcgoertz.de/)"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mrcgrtz/redux-responsive.git"
    },
    "homepage": "https://github.com/mrcgrtz/redux-responsive#readme",
    "bugs": "https://github.com/mrcgrtz/redux-responsive/issues",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "default": "./dist/react/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean": "rm -rf dist coverage",
        "dev": "vite example",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
        "typecheck": "tsc",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --test 'src/**/*.test.ts'",
        "test:watch": "node --test --watch 'src/**/*.test.ts'",
        "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude='src/**/*.test.ts' --test-coverage-lines=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'src/**/*.test.ts'",
        "prepack": "npm run clean && npm run build"
    },
    "prettier": {
        "tabWidth": 4,
        "semi": false,
        "singleQuote": true,
        "printWidth": 100,
        "trailingComma": "es5"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-redux": "^9.0.0",
        "redux": "^5.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-redux": {
            "optional": true
        }
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@reduxjs/toolkit": "^2.15.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "immutable": "^5.2.1",
        "prettier": "^3.10.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-redux": "^9.3.1",
        "redux": "^5.0.1",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.8"
    }
}
