{
    "name": "@mrcgrtz/redux-responsive",
    "version": "5.0.0",
    "description": "Utilities for easily creating responsive designs in a redux architecture.",
    "license": "MIT",
    "repository": "github:mrcgrtz/redux-responsive",
    "homepage": "https://github.com/mrcgrtz/redux-responsive#readme",
    "bugs": "https://github.com/mrcgrtz/redux-responsive/issues",
    "author": "Alec Aivazis",
    "contributors": [
        "Marc Görtz <mail@marcgoertz.de> (https://marcgoertz.de/)"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react/index.d.ts",
            "default": "./dist/react/index.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "engines": {
        "node": ">=26"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean": "rm -rf dist coverage",
        "dev": "vite example",
        "check": "npm run typecheck && npm run lint && npm test && npm run test:readme",
        "typecheck": "tsc",
        "lint": "xo",
        "format": "xo --fix",
        "test": "node --test 'src/**/*.test.ts'",
        "test:watch": "node --test --watch 'src/**/*.test.ts'",
        "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-exclude='src/**/*.test.ts' --test-coverage-lines=90 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'src/**/*.test.ts'",
        "test:readme": "node scripts/check-readme.ts",
        "prepack": "npm run clean && npm run build",
        "prepare": "husky"
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "redux",
        "react",
        "responsive",
        "media-queries",
        "breakpoints"
    ],
    "devDependencies": {
        "@reduxjs/toolkit": "^2.15.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "husky": "^9.1.7",
        "immutable": "^5.2.1",
        "lint-staged": "^17.6.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-redux": "^9.3.1",
        "redux": "^5.0.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.8",
        "xo": "^5.0.1"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-redux": "^9.0.0",
        "redux": "^5.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-redux": {
            "optional": true
        }
    },
    "lint-staged": {
        "*.{js,ts,tsx,json,md,html}": "xo --fix"
    }
}
